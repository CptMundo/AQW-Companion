{
  "manifest_version": 3,
  "name": "AQW Companion",
  "version": "0.12.51",
  "description": "Customize AQWorlds Wiki and connect your local inventory, Wishlist and daily/weekly quest tracker.",
  "action": {
    "default_title": "AQW Companion",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://cptmundo.github.io/AQW-Companion/extension-connect.html"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://cptmundo.github.io/AQW-Companion/",
        "https://cptmundo.github.io/AQW-Companion/index.html"
      ],
      "js": [
        "sync.js",
        "account-bridge.js",
        "mini-tracker.js",
        "wishlist-queue.js",
        "badge-bridge.js",
        "unified-sync.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://aqwwiki.wikidot.com/*"
      ],
      "js": [
        "companion-theme.js",
        "wiki-theme.js",
        "bridge.js",
        "wishlist-link.js",
        "wiki-materials.js",
        "wiki-list-ownership.js",
        "wiki-items.js",
        "wiki-quest-shop.js",
        "wiki-directory.js",
        "wiki-boosts.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": [
        "https://aqwwiki.wikidot.com/*"
      ],
      "js": [
        "wiki-first-paint.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "optional_host_permissions": [
    "https://account.aq.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "image_2026-11-24_232002011.png",
        "prometheus-helm.svg",
        "category-icons.png",
        "boost-index.json"
      ],
      "matches": [
        "https://aqwwiki.wikidot.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/store128.png"
  }
}
