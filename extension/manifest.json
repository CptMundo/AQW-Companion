{
  "manifest_version": 3,
  "name": "AQW Companion",
  "version": "0.9.0",
  "description": "Local AQW Companion inventory lookup on AQWorlds Wiki item pages.",
  "action": {
    "default_title": "AQW Companion",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cptmundo.github.io/AQW-Companion/extension-connect.html"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://cptmundo.github.io/AQW-Companion/",
        "https://cptmundo.github.io/AQW-Companion/index.html"
      ],
      "js": [
        "sync.js",
        "account-bridge.js",
        "wishlist-queue.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://aqwwiki.wikidot.com/*"
      ],
      "js": [
        "bridge.js",
        "wishlist-link.js",
        "wiki-materials.js",
        "wiki-items.js",
        "wiki-quest-shop.js",
        "wiki-list-ownership.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "optional_host_permissions": [
    "https://account.aq.com/*"
  ]
}
